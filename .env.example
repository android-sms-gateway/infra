# Environment Configuration Template for android-sms-gateway infra stack
# Copy this file to .env and fill in your actual values
# This file contains all required environment variables with examples and documentation
# Compose files consuming these variables: compose.app.yml, compose.infra.yml,
# compose.monitoring.yml. Traefik dynamic.yml consumes METRICS_IP_WHITELIST
# which is derived from TRAEFIK__METRICS_IP_WHITELIST.

# =============================================================================
# COMMON CONFIGURATION
# =============================================================================

# TIMEZONE
# Purpose: Container timezone (TZ) for every service; also used as backend/worker DATABASE__TIMEZONE
# Format: IANA timezone name
# Default: UTC
# Example: Europe/Berlin
TIMEZONE=UTC

# ROOT_DOMAIN
# Purpose: Base domain for all publicly exposed hostnames routed by Traefik
#          (api., smpp., smtp., webhook., dashboard., pma., admin., ca., prometheus., alerts., mon.)
# Format: Domain name (no protocol, no trailing dot)
# Example: example.com
ROOT_DOMAIN=example.com

# STACK_VERSION
# Purpose: Suffix for Swarm config names; bump it to force re-deployment of updated config files
# Format: Integer
# Default: 0
STACK_VERSION=0

# =============================================================================
# INFRA STACK - DATABASE BACKUP
# =============================================================================

# DB_BACKUP__AWS_REGION
# Purpose: AWS region of the S3 bucket that holds MariaDB backups; used by the db-backup service (AWS_REGION)
# Format: AWS region name
# Default: us-east-1
# Example: eu-central-1
DB_BACKUP__AWS_REGION=us-east-1

# DB_BACKUP__AWS_ACCESS_KEY_ID
# Purpose: IAM access key ID with write access to the backup S3 bucket (mapped to AWS_ACCESS_KEY)
# Format: AWS access key ID
# Example: your-aws-access-key-id
DB_BACKUP__AWS_ACCESS_KEY_ID=your-aws-access-key-id

# DB_BACKUP__AWS_SECRET_ACCESS_KEY
# Purpose: IAM secret key paired with the access key ID above (mapped to AWS_SECRET_KEY)
# Format: AWS secret access key
# Example: your-aws-secret-access-key
DB_BACKUP__AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# DB_BACKUP__PASSWORD
# Purpose: Password of the MariaDB "backup" user used by the db-backup service (mapped to MARIADB__PASSWORD)
# Format: String
# Example: your-db-backup-password
DB_BACKUP__PASSWORD=your-db-backup-password

# DB_BACKUP__OPTIONS
# Purpose: Extra mysqldump options appended to db-backup (mapped to MARIADB__BACKUP_OPTIONS)
# Format: Space-separated mysqldump options
# Default: --skip-ssl
# Example: --skip-ssl --single-transaction
DB_BACKUP__OPTIONS=--skip-ssl

# DB_BACKUP__STORAGE_URL
# Purpose: S3 destination where db-backup uploads the dump (mapped to STORAGE__URL)
# Format: s3://bucket/object-prefix
# Example: s3://my-sms-gateway-backups/prod/
DB_BACKUP__STORAGE_URL=s3://db-backup/prefix

# DB_BACKUP__SCHEDULE
# Purpose: Cron expression for the swarm-cronjob triggers db-backup (label swarm.cronjob.schedule)
# Format: cron expression (6 fields); single quotes required in .env
# Default: '@daily'
# Example: '0 0 2 * * *'
DB_BACKUP__SCHEDULE='@daily'

# =============================================================================
# INFRA STACK - TRAEFIK
# =============================================================================

# DB_ADMIN_AUTH
# Purpose: htpasswd credential pair protecting phpMyAdmin on pma.<ROOT_DOMAIN> via Traefik basicAuth middleware
# Format: username:hashed-password (bcrypt hash from htpasswd -B; escape $ as $$ inside .env so Compose keeps $)
# Example: admin:$$2y$$05$$XAvHGxVOHRMuljNcIIYVAeipkW93TiWTl2nAWJyKsq0QIXKdqmRTu
DB_ADMIN_AUTH=admin:$$2y$$05$$XAvHGxVOHRMuljNcIIYVAeipkW93TiWTl2nAWJyKsq0QIXKdqmRTu

# DASHBOARD_AUTH
# Purpose: htpasswd credential pair protecting the Traefik dashboard on admin.<ROOT_DOMAIN>
# Format: username:hashed-password (bcrypt hash from htpasswd -B; escape $ as $$ inside .env so Compose keeps $)
# Example: admin:$$2y$$05$$m/cRYoQhKSC3PEZGJpQrWOCz.ASWjqOOO65EDIU9npUg0WfVjk1ea
DASHBOARD_AUTH=admin:$$2y$$05$$m/cRYoQhKSC3PEZGJpQrWOCz.ASWjqOOO65EDIU9npUg0WfVjk1ea

# TRAEFIK_METRICS_IP_WHITELIST
# Purpose: IP/CIDR ranges allowed to reach Traefik metrics middleware; read from METRICS_IP_WHITELIST in traefik/dynamic.yml
# Format: Comma-separated IP addresses or CIDR ranges
# Example: 127.0.0.1,192.168.0.0/16
TRAEFIK__METRICS_IP_WHITELIST=127.0.0.1,192.168.0.0/16

# TRAEFIK_CF_DNS_API_TOKEN
# Purpose: Cloudflare API token (DNS edit permission) used by Traefik ACME DNS-01 challenge for the "cloudflare" cert resolver
# Format: Cloudflare API token
# Example: your-cloudflare-api-token
TRAEFIK__CF_DNS_API_TOKEN=your-cloudflare-api-token

# =============================================================================
# MONITORING STACK
# =============================================================================

# PROMETHEUS_IP_ALLOWLIST
# Purpose: IP/CIDR ranges allowed to open Prometheus UI (prometheus.<ROOT_DOMAIN>) via Traefik ipAllowlist middleware
# Format: Comma-separated IP addresses or CIDR ranges
# Example: 127.0.0.1,192.168.0.0/16
PROMETHEUS__IP_ALLOWLIST=127.0.0.1,192.168.0.0/16

# ALERTMANAGER_IP_ALLOWLIST
# Purpose: IP/CIDR ranges allowed to open Alertmanager UI (alerts.<ROOT_DOMAIN>) via Traefik ipAllowlist middleware
# Format: Comma-separated IP addresses or CIDR ranges
# Example: 127.0.0.1,192.168.0.0/16
ALERTMANAGER__IP_ALLOWLIST=127.0.0.1,192.168.0.0/16

# =============================================================================
# APP STACK - HTTP / PROXY
# =============================================================================

# HTTP_PROXY_HEADER
# Purpose: Header carrying the real client IP, read by backend, ca-backend, email-to-sms and web-dashboard (HTTP__PROXY_HEADER)
# Format: HTTP header name
# Default: X-Forwarded-For
# Example: X-Forwarded-For
HTTP__PROXY_HEADER=X-Forwarded-For

# HTTP_PROXIES
# Purpose: Comma-separated list of trusted proxy IP ranges; requests from other sources are treated as direct clients (HTTP__PROXIES)
# Format: Comma-separated IP addresses or CIDR ranges
# Example: 10.0.0.0/16
HTTP__PROXIES=10.0.0.0/16

# API_SUBDOMAIN
# Purpose: Subdomain serving backend API routes (PathPrefix /3rdparty, /upstream, /mobile) via api.<ROOT_DOMAIN>
# Format: DNS label
# Default: api
API_SUBDOMAIN=api

# =============================================================================
# APP STACK - BACKEND DATABASE
# =============================================================================

# BACKEND_DATABASE_HOST
# Purpose: MariaDB hostname reached by backend and worker containers (mapped to DATABASE__HOST)
# Format: Hostname or IP reachable on the internal Swarm network
# Default: db
BACKEND__DATABASE__HOST=db

# BACKEND_DATABASE_USER
# Purpose: MariaDB login user used by backend and worker (mapped to DATABASE__USER)
# Format: MariaDB user name
# Default: backend
BACKEND__DATABASE__USER=backend

# BACKEND_DATABASE_PASSWORD
# Purpose: MariaDB password for the user above (mapped to DATABASE__PASSWORD)
# Format: String
# Example: your-backend-db-password
BACKEND__DATABASE__PASSWORD=your-backend-db-password

# BACKEND_DATABASE_DATABASE
# Purpose: Default database name used by backend and worker (mapped to DATABASE__DATABASE)
# Format: MariaDB database name
# Default: backend
BACKEND__DATABASE__DATABASE=backend

# BACKEND_DATABASE_MAX_OPEN_CONNS
# Purpose: Maximum number of open database connections; 0 (or empty) means no limit (mapped to DATABASE__MAX_OPEN_CONNS)
# Format: Integer >= 0
# Default: 0
BACKEND__DATABASE__MAX_OPEN_CONNS=0

# BACKEND_DATABASE_MAX_IDLE_CONNS
# Purpose: Maximum number of idle database connections; 0 (or empty) means no limit (mapped to DATABASE__MAX_IDLE_CONNS)
# Format: Integer >= 0
# Default: 0
BACKEND__DATABASE__MAX_IDLE_CONNS=0

# =============================================================================
# APP STACK - FCM (FIREBASE CLOUD MESSAGING)
# =============================================================================

# FCM_CREDENTIALS_JSON
# Purpose: Google service-account key JSON used by backend for Firebase Cloud Messaging push notifications
# Format: JSON as a single-line quoted string (required by backend container)
# Example: '{"type":"service_account","project_id":"your-project","client_email":"your-email@your-project.iam.gserviceaccount.com"}'
FCM__CREDENTIALS_JSON='{"type":"service_account","project_id":"your-project","client_email":"your-email@your-project.iam.gserviceaccount.com"}'

# =============================================================================
# APP STACK - CERTIFICATE AUTHORITY
# =============================================================================

# CSR_TTL
# Purpose: Validity period of certificates issued by the ca-backend service (mapped to CSR__TTL)
# Format: Go duration (e.g. 24h, 720h)
# Default: 24h
# Example: 720h
CSR__TTL=24h

# CSR_CA_CERT_PATH
# Purpose: Path inside ca-backend to the mounted root CA certificate (CSR__CA_CERT_PATH)
# Format: File path in the container; source: Swarm secret root-ca.crt
# Default: /run/secrets/ca.crt
CSR__CA_CERT_PATH=/run/secrets/ca.crt

# CSR_CA_KEY_PATH
# Purpose: Path inside service container to the root CA private key (CSR__CA_KEY_PATH)
# Format: File path in the container; source: Swarm secret root-ca.key
# Default: /run/secrets/ca.key
CSR__CA_KEY_PATH=/run/secrets/ca.key

# =============================================================================
# APP STACK - SMPP
# =============================================================================

# SMPP_GATEWAY_API_BASE_URL
# Purpose: Base URL of the backend 3rd-party API used by smpp-server as SMS gateway (mapped to GATEWAY__API_BASE_URL)
# Format: URL reachable on the internal Swarm network
# Default: http://backend:3000/api/3rdparty/v1
# Example: http://backend:3000/api/3rdparty/v1
SMPP__GATEWAY__API_BASE_URL=http://backend:3000/api/3rdparty/v1

# =============================================================================
# APP STACK - SMTP (EMAIL TO SMS)
# =============================================================================

# EMAIL_TO_SMS_GATEWAY_API_BASE_URL
# Purpose: Base URL of the backend 3rd-party API used by email-to-sms service as SMS gateway (mapped to SMSGATE__URL)
# Format: URL reachable inside the internal Swarm network
# Default: http://backend:3000/api/3rdparty/v1
# Example: http://backend:3000/api/3rdparty/v1
EMAIL_TO_SMS__GATEWAY__API_BASE_URL=http://backend:3000/api/3rdparty/v1

# =============================================================================
# APP STACK - WEBHOOK TESTER
# =============================================================================

# WEBHOOK_REDIS_DSN
# Purpose: Redis connection DSN used by webhook-tester for storage and pub/sub (mapped to REDIS_DSN)
# Format: redis://[user[:password]@]host:port/db
# Default: redis://redis:6379/1
# Example: redis://redis:6379/1
WEBHOOK__REDIS_DSN=redis://redis:6379/1

# =============================================================================
# APP STACK - WEB DASHBOARD
# =============================================================================

# WEB_DASHBOARD_GATEWAY_URL
# Purpose: Base URL of the backend 3rd-party API used by web-dashboard (mapped to GATEWAY__URL)
# Format: URL reachable over the internal Swarm network
# Default: http://backend:3000/api/3rdparty/v1
# Example: http://backend:3000/api/3rdparty/v1
WEB_DASHBOARD__GATEWAY__URL=http://backend:3000/api/3rdparty/v1